NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://usuario:senha@localhost:5433/allu_invest?schema=public"

# Role restrito, sem privilegio de superuser — quem o backend usa em runtime.
# Criado pela migration de RLS. DATABASE_URL (acima) so serve pra
# prisma migrate/generate, que precisam de privilegio de dono do schema.
RUNTIME_DATABASE_URL="postgresql://allu_invest_app:senha-do-role-restrito@localhost:5433/allu_invest?schema=public"

FILE_STORAGE_PATH=./uploads

# Chave publica RS256 do Identity Provider, usada para VERIFICAR tokens.
# A chave privada correspondente nunca fica nesta API (fica com o IdP).
# Para desenvolvimento local, gere um par com `openssl genrsa`/`openssl rsa -pubout`
# e aponte para o .pem gerado, ou copie a chave publica de uso local.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
<cole aqui a chave publica RS256 do ambiente>
-----END PUBLIC KEY-----
"
JWT_ISSUER=allu-invest-idp
JWT_AUDIENCE=allu-invest-api

# Lista separada por virgula das origens autorizadas a chamar a API via CORS.
# Sem essa variavel, cai no fallback de desenvolvimento (http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173
